---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Auditoría Forense · OpenIoTCore">
  <Navbar />

  <main class="container-fluid px-4 py-4 flex-grow-1" style="max-width: 1440px;">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <h6 class="mb-1 fw-semibold text-light" style="font-size: 15px;">Registro de auditoría forense</h6>
        <p class="text-secondary small mb-0" style="font-size: 12.5px;">Trazabilidad completa de intentos de acceso, lecturas RFID no autorizadas y anomalías.</p>
      </div>
      <div>
        <button class="btn-secondary-dark d-inline-flex align-items-center gap-2" id="btn-export-pdf">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Exportar informe</span>
        </button>
      </div>
    </div>

    <!-- Card 1: Filtros de búsqueda forense -->
    <div class="card-technical mb-4 p-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <h6 class="fw-semibold text-light mb-0" style="font-size: 14px;">Criterios de filtrado</h6>
      </div>

      <form id="form-audit-filter">
        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <label class="form-label text-secondary small fw-medium mb-1">Fecha inicial</label>
            <input type="date" class="form-control form-control-dark font-mono" id="filter-date-start" />
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary small fw-medium mb-1">Fecha final</label>
            <input type="date" class="form-control form-control-dark font-mono" id="filter-date-end" />
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary small fw-medium mb-1">Resultado</label>
            <select class="form-select form-select-dark" id="filter-result">
              <option value="ALL">Todos los eventos</option>
              <option value="DENIED" selected>Solo accesos denegados</option>
              <option value="GRANTED">Solo accesos concedidos</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label text-secondary small fw-medium mb-1">Punto de acceso</label>
            <select class="form-select form-select-dark" id="filter-door">
              <option value="ALL">Todas las puertas</option>
              <option value="Puerta Principal">Puerta Principal</option>
              <option value="Puerta Almacén">Puerta Almacén</option>
              <option value="Laboratorio I+D">Laboratorio I+D</option>
              <option value="Data Center (Piso 1)">Data Center (Piso 1)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="form-label text-secondary small fw-medium mb-1">Filtro rápido por UID, persona o causa</label>
          <div class="input-group">
            <input 
              type="text" 
              class="form-control form-control-dark font-mono" 
              id="filter-search" 
              placeholder="Buscar por UID (ej: 4A8F12C9), nombre o anomalía..."
            />
            <button type="submit" class="btn-primary-dark d-flex align-items-center gap-2">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span>Aplicar filtros</span>
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Card 2: Resultados de la auditoría -->
    <div class="card-technical mb-4">
      <div class="card-header-technical d-flex justify-content-between align-items-center">
        <div>
          <h6 class="mb-0 fw-semibold text-light" style="font-size: 14.5px;">Registros de paso auditados</h6>
          <span class="text-muted small" style="font-size: 12px;">Eventos inmutables capturados por los microcontroladores de acceso.</span>
        </div>
        <span class="uid-badge font-mono" id="badge-count" style="font-size: 11px;">
          Sincronizando registros...
        </span>
      </div>
      <div class="table-responsive">
        <table class="table-technical">
          <thead>
            <tr>
              <th class="ps-4">Timestamp</th>
              <th>Punto de acceso</th>
              <th>Credencial / Sujeto</th>
              <th>Causa / Diagnóstico</th>
              <th class="pe-4 text-end">Detalle</th>
            </tr>
          </thead>
          <tbody id="audit-table-body">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
      <div class="card-header-technical d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2" style="border-top: 1px solid var(--border-hairline); border-bottom: 0;">
        <div class="text-muted small font-mono" id="pagination-info" style="font-size: 12px;">
          Consultando base de eventos...
        </div>
      </div>
    </div>
  </main>

  <!-- Modal Detalle del Incidente -->
  <div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <div class="brand-icon-box" style="width: 24px; height: 24px;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h6 class="modal-title fw-semibold text-light mb-0" style="font-size: 14.5px;">Inspección forense de registro</h6>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-4" id="modal-detalle-body">
          <!-- Filled by JS -->
        </div>
        <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-end">
          <button type="button" class="btn-secondary-dark" data-bs-dismiss="modal">Cerrar inspección</button>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.openiotcore.org';

  const SAMPLE_AUDIT_LOGS = [
    {
      id: "LOG-9001",
      fecha: "2026-10-24 03:12:01",
      puerta: "Data Center (Piso 1)",
      tarjetaUid: "90AA11BB",
      persona: "Tarjeta no empadronada",
      area: "No identificado",
      resultado: "DENIED",
      motivo: "Credencial inexistente en base de datos",
      ip: "192.168.1.107",
      modo: "En línea (Servidor Central)"
    },
    {
      id: "LOG-9002",
      fecha: "2026-10-23 22:05:14",
      puerta: "Puerta Almacén",
      tarjetaUid: "E200194B",
      persona: "Miguel Vargas",
      area: "DevOps & QA",
      resultado: "DENIED",
      motivo: "Fuera de ventana autorizada (Límite: 18:00)",
      ip: "192.168.1.106",
      modo: "En línea"
    },
    {
      id: "LOG-9003",
      fecha: "2026-10-23 19:40:02",
      puerta: "Laboratorio I+D",
      tarjetaUid: "B743110C",
      persona: "Juan Pérez",
      area: "Logística",
      resultado: "DENIED",
      motivo: "Credencial revocada por seguridad",
      ip: "192.168.1.107",
      modo: "Caché NVS local (Sin red)"
    },
    {
      id: "LOG-9004",
      fecha: "2026-10-23 18:14:02",
      puerta: "Puerta Principal",
      tarjetaUid: "4A8F12C9",
      persona: "Carlos Quispe",
      area: "Arquitectura IoT",
      resultado: "GRANTED",
      motivo: "Acceso autorizado por regla activa",
      ip: "192.168.1.105",
      modo: "En línea"
    },
    {
      id: "LOG-9005",
      fecha: "2026-10-23 14:02:11",
      puerta: "Puerta Principal",
      tarjetaUid: "A4B2C190",
      persona: "Tarjeta no registrada",
      area: "Desconocido",
      resultado: "DENIED",
      motivo: "Credencial no empadronada (UID: A4B2C190)",
      ip: "192.168.1.105",
      modo: "En línea"
    },
    {
      id: "LOG-9006",
      fecha: "2026-10-22 10:12:10",
      puerta: "Puerta Almacén",
      tarjetaUid: "B743110C",
      persona: "Andrea Álvarez",
      area: "Logística",
      resultado: "GRANTED",
      motivo: "Validado en caché local NVS",
      ip: "192.168.1.106",
      modo: "Caché NVS local (Sin red)"
    }
  ];

  let currentLogs = [...SAMPLE_AUDIT_LOGS];

  document.addEventListener('DOMContentLoaded', async () => {
    const startInput = document.getElementById('filter-date-start') as HTMLInputElement;
    const endInput = document.getElementById('filter-date-end') as HTMLInputElement;
    if (startInput) startInput.value = "2026-10-01";
    if (endInput) endInput.value = "2026-10-24";

    await loadRealLogs();

    document.getElementById('form-audit-filter')?.addEventListener('submit', (e) => {
      e.preventDefault();
      applyFilters();
    });

    document.getElementById('btn-export-pdf')?.addEventListener('click', exportPDF);
  });

  async function loadRealLogs() {
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/logs`, {
        headers: token ? { 'Authorization': `Bearer ${token}` } : {}
      });
      if (res.ok) {
        const data = await res.json();
        const rawItems = data.resultados || (Array.isArray(data) ? data : []);
        if (rawItems.length > 0) {
          const mapped = rawItems.map((item: any, index: number) => {
            const isGranted = item.evento === 'PERMITIDO';
            const personName = item.nombre ? `${item.nombre} ${item.apellido || ''}` : (isGranted ? "Personal Autorizado" : "Tarjeta no empadronada");
            return {
              id: `LOG-${item.id || index + 100}`,
              fecha: item.timestamp ? new Date(item.timestamp).toLocaleString('es-PE') : new Date().toLocaleString('es-PE'),
              puerta: item.ubicacion || item.dispositivo_id || "Puerta Principal",
              tarjetaUid: item.uid_leido || "A4B2C190",
              persona: personName,
              area: item.departamento || "General",
              resultado: isGranted ? "GRANTED" : "DENIED",
              motivo: item.razon || (isGranted ? "Acceso autorizado" : "Acceso denegado"),
              ip: item.ip || "192.168.1.105",
              modo: item.evento && item.evento.includes('OFFLINE') ? "Caché NVS local" : "En línea"
            };
          });
          currentLogs = [...mapped, ...SAMPLE_AUDIT_LOGS];
        }
      }
    } catch (e) {}
    applyFilters();
  }

  function applyFilters() {
    const resFilter = (document.getElementById('filter-result') as HTMLSelectElement)?.value;
    const doorFilter = (document.getElementById('filter-door') as HTMLSelectElement)?.value;
    const searchFilter = (document.getElementById('filter-search') as HTMLInputElement)?.value.toLowerCase().trim();

    let filtered = currentLogs.filter(log => {
      if (resFilter !== 'ALL' && log.resultado !== resFilter) return false;
      if (doorFilter !== 'ALL' && log.puerta !== doorFilter) return false;
      if (searchFilter) {
        const matchSearch = log.persona.toLowerCase().includes(searchFilter) ||
                            log.tarjetaUid.toLowerCase().includes(searchFilter) ||
                            log.motivo.toLowerCase().includes(searchFilter) ||
                            log.puerta.toLowerCase().includes(searchFilter);
        if (!matchSearch) return false;
      }
      return true;
    });

    renderAuditTable(filtered);
  }

  function renderAuditTable(logs: typeof SAMPLE_AUDIT_LOGS) {
    const tbody = document.getElementById('audit-table-body');
    const badgeCount = document.getElementById('badge-count');
    const paginationInfo = document.getElementById('pagination-info');

    if (badgeCount) badgeCount.textContent = `${logs.length} eventos registrados`;
    if (paginationInfo) paginationInfo.textContent = `Mostrando ${logs.length} de ${logs.length} registros`;

    if (!tbody) return;

    if (logs.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="text-center py-5 text-muted font-mono" style="font-size: 13px;">
            No se hallaron registros que coincidan con los criterios establecidos.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = logs.map(log => {
      const isDenied = log.resultado === 'DENIED';
      const motivoHtml = isDenied 
        ? `<span class="status-pill status-denied"><span class="metric-status-dot dot-crimson"></span>${log.motivo}</span>`
        : `<span class="status-pill status-granted"><span class="metric-status-dot dot-online"></span>${log.motivo}</span>`;

      return `
        <tr>
          <td class="ps-4 font-mono text-muted" style="font-size: 12.5px;">${log.fecha}</td>
          <td><span class="text-light fw-medium">${log.puerta}</span></td>
          <td>
            <div class="d-flex flex-column">
              <span class="text-light fw-medium">${log.persona}</span>
              <span class="uid-badge font-mono mt-1" style="font-size: 11px;">UID: ${log.tarjetaUid}</span>
            </div>
          </td>
          <td>${motivoHtml}</td>
          <td class="pe-4 text-end">
            <button class="btn-secondary-dark font-mono btn-inspect" style="font-size: 11px; padding: 3px 8px;" data-log-id="${log.id}">
              Inspeccionar
            </button>
          </td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.btn-inspect').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const logId = (e.currentTarget as HTMLElement).getAttribute('data-log-id');
        const item = logs.find(l => l.id === logId);
        if (item) showInspectModal(item);
      });
    });
  }

  function showInspectModal(log: any) {
    const body = document.getElementById('modal-detalle-body');
    if (!body) return;

    body.innerHTML = `
      <div class="mb-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small font-mono" style="font-size: 11.5px;">ID DE REGISTRO</span>
        <span class="uid-badge font-mono">${log.id}</span>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-6">
          <label class="text-muted small font-mono d-block mb-1" style="font-size: 11px;">FECHA Y HORA</label>
          <div class="font-mono text-light" style="font-size: 13px;">${log.fecha}</div>
        </div>
        <div class="col-6">
          <label class="text-muted small font-mono d-block mb-1" style="font-size: 11px;">DICTAMEN</label>
          <div>
            ${log.resultado === 'GRANTED' 
              ? '<span class="status-pill status-granted"><span class="metric-status-dot dot-online"></span>Concedido</span>'
              : '<span class="status-pill status-denied"><span class="metric-status-dot dot-crimson"></span>Denegado</span>'}
          </div>
        </div>
      </div>

      <div class="p-3 rounded mb-3" style="background: var(--bg-surface); border: 1px solid var(--border-hairline);">
        <label class="text-muted small font-mono d-block mb-1" style="font-size: 11px;">DIAGNÓSTICO DEL CONTROLADOR</label>
        <div class="font-mono small ${log.resultado === 'DENIED' ? 'text-danger' : 'text-success'}">
          ${log.motivo}
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-6">
          <label class="text-muted small font-mono d-block mb-1" style="font-size: 11px;">DISPOSITIVO RECEPTOR</label>
          <div class="text-light fw-medium small">${log.puerta}</div>
          <span class="text-muted font-mono" style="font-size: 11px;">IP: ${log.ip}</span>
        </div>
        <div class="col-6">
          <label class="text-muted small font-mono d-block mb-1" style="font-size: 11px;">CREDENCIAL DETECTADA</label>
          <div class="font-mono text-light small">UID: ${log.tarjetaUid}</div>
          <span class="text-secondary small">${log.persona}</span>
        </div>
      </div>

      <div class="pt-2" style="border-top: 1px solid var(--border-hairline);">
        <span class="text-muted small font-mono" style="font-size: 11px;">MODO DE VALIDACIÓN: ${log.modo}</span>
      </div>
    `;

    const modalEl = document.getElementById('modalDetalle');
    if (modalEl) {
      const modal = new (window as any).bootstrap.Modal(modalEl);
      modal.show();
    }
  }

  function exportPDF() {
    window.print();
  }
</script>
