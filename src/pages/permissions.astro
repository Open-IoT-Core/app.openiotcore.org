---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Reglas y Horarios de Acceso · OpenIoTCore">
  <Navbar />

  <main class="container-fluid px-4 py-4 flex-grow-1" style="max-width: 1440px;">
    <!-- Header -->
    <div class="mb-4">
      <h6 class="mb-1 fw-semibold text-light" style="font-size: 15px;">Matriz de permisos y horarios autorizados</h6>
      <p class="text-secondary small mb-0" style="font-size: 12.5px;">Configuración de ventanas horarias, días de la semana y puertas asignadas a cada colaborador.</p>
    </div>

    <div id="perm-alert"></div>

    <!-- Formulario Principal -->
    <div class="card-technical mb-4 p-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <h6 class="fw-semibold text-light mb-0" style="font-size: 14px;">Asignar nueva política de acceso</h6>
      </div>

      <form id="form-permission">
        <!-- Fila 1: Persona autorizada & Puerta/Área -->
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-medium mb-1">Colaborador autorizado</label>
            <select class="form-select form-select-dark" id="select-persona" required>
              <option value="">Cargando personas...</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-medium mb-1">Punto de acceso / Dispositivo</label>
            <select class="form-select form-select-dark" id="select-puerta" required>
              <option value="">Cargando dispositivos...</option>
            </select>
          </div>
        </div>

        <!-- Días de la semana permitidos (Tactile Chip Selectors) -->
        <div class="mb-3">
          <label class="form-label text-secondary small fw-medium mb-1 d-block">Días de la semana permitidos</label>
          <div class="d-flex flex-wrap gap-2">
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="1" id="day-lun" checked autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-lun">Lun</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="2" id="day-mar" checked autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-mar">Mar</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="3" id="day-mie" checked autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-mie">Mié</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="4" id="day-jue" checked autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-jue">Jue</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="5" id="day-vie" checked autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-vie">Vie</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="6" id="day-sab" autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-sab">Sáb</label>
            </div>
            <div class="form-check form-check-inline m-0">
              <input class="btn-check" type="checkbox" value="7" id="day-dom" autocomplete="off" />
              <label class="btn btn-secondary-dark font-mono" style="font-size: 12px; padding: 5px 12px;" for="day-dom">Dom</label>
            </div>
          </div>
        </div>

        <!-- Horarios y Vigencia -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="form-label text-secondary small fw-medium mb-1">Hora inicio</label>
            <input type="time" class="form-control form-control-dark font-mono" id="hora-inicio" value="08:00" required />
          </div>
          <div class="col-md-4">
            <label class="form-label text-secondary small fw-medium mb-1">Hora final</label>
            <input type="time" class="form-control form-control-dark font-mono" id="hora-fin" value="18:00" required />
          </div>
          <div class="col-md-4">
            <label class="form-label text-secondary small fw-medium mb-1">Fecha límite de vigencia</label>
            <input type="date" class="form-control form-control-dark font-mono" id="fecha-limite" value="2026-12-31" required />
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="d-flex justify-content-end gap-2 pt-3" style="border-top: 1px solid var(--border-hairline);">
          <button type="reset" class="btn-secondary-dark">Restablecer</button>
          <button type="submit" class="btn-primary-dark d-inline-flex align-items-center gap-2" id="btn-save-perm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Sincronizar regla con el nodo</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Reglas Configuradas Actuales -->
    <div class="card-technical">
      <div class="card-header-technical d-flex justify-content-between align-items-center">
        <div>
          <h6 class="mb-0 fw-semibold text-light" style="font-size: 14.5px;">Reglas y políticas activas</h6>
          <span class="text-muted small" style="font-size: 12px;">Sincronizadas con la memoria local de cada cerradura IoT.</span>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table-technical">
          <thead>
            <tr>
              <th class="ps-4">Colaborador</th>
              <th>Punto de acceso</th>
              <th>Horario permitido</th>
              <th>Días de la semana</th>
              <th>Vigencia</th>
              <th>Estado</th>
              <th class="text-end pe-4">Acciones</th>
            </tr>
          </thead>
          <tbody id="permissions-table-body">
            <tr><td colspan="7" class="text-center py-4 text-muted font-mono" style="font-size: 12.5px;">Consultando permisos...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.openiotcore.org';

  document.addEventListener('DOMContentLoaded', () => {
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/login';
      return;
    }

    loadOptions();
    loadPermissions();
    setupForm();
  });

  function formatDays(daysArray: any) {
    if (!Array.isArray(daysArray) || daysArray.length === 0) return 'Ningún día';
    const names = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
    if (daysArray.length === 7) return 'Todos los días';
    if (daysArray.length === 5 && daysArray.join(',') === '1,2,3,4,5') return 'Lun - Vie';
    return daysArray.map((d: number) => names[d - 1] || d).join(', ');
  }

  async function loadOptions() {
    const token = localStorage.getItem('token');
    const selectUsr = document.getElementById('select-persona') as HTMLSelectElement;
    const selectDoor = document.getElementById('select-puerta') as HTMLSelectElement;

    try {
      const [uRes, dRes] = await Promise.all([
        fetch(`${API_URL}/api/v1/users`, { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch(`${API_URL}/api/v1/devices/my-devices`, { headers: { 'Authorization': `Bearer ${token}` } })
      ]);

      if (uRes.ok && selectUsr) {
        const users = await uRes.json();
        selectUsr.innerHTML = '<option value="">Selecciona una persona...</option>' +
          users.map((u: any) => `<option value="${u.id}">${u.nombre} ${u.apellido}</option>`).join('');
      }

      if (dRes.ok && selectDoor) {
        const doors = await dRes.json();
        selectDoor.innerHTML = '<option value="">Selecciona un dispositivo...</option>' +
          doors.map((d: any) => `<option value="${d.id}">${d.ubicacion} (${d.zona_piso || 'Entrada'})</option>`).join('');
      }
    } catch (e) {}
  }

  async function loadPermissions() {
    const token = localStorage.getItem('token');
    const tbody = document.getElementById('permissions-table-body');
    try {
      const res = await fetch(`${API_URL}/api/v1/permissions`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al cargar permisos');
      const perms = await res.json();

      if (!tbody) return;

      if (perms.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted font-mono" style="font-size: 12.5px;">No hay reglas de acceso registradas.</td></tr>`;
        return;
      }

      tbody.innerHTML = perms.map((p: any) => `
        <tr>
          <td class="ps-4 fw-medium text-light">${p.nombre} ${p.apellido}</td>
          <td class="text-secondary">${p.ubicacion}</td>
          <td class="font-mono text-light" style="font-size: 12.5px;">${p.hora_inicio} - ${p.hora_fin}</td>
          <td><span class="uid-badge font-mono" style="font-size: 11px;">${formatDays(p.dias_semana)}</span></td>
          <td class="font-mono text-muted" style="font-size: 12px;">${new Date(p.fecha_limite).toLocaleDateString()}</td>
          <td>
            <span class="status-pill ${p.activo ? 'status-granted' : 'status-neutral'}">
              <span class="metric-status-dot ${p.activo ? 'dot-online' : 'dot-amber'}"></span>
              ${p.activo ? 'Vigente' : 'Pausado'}
            </span>
          </td>
          <td class="text-end pe-4">
            <button class="btn-secondary-dark font-mono text-danger btn-delete-perm" style="font-size: 11px; padding: 3px 8px;" data-perm-id="${p.id}">
              Eliminar
            </button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll('.btn-delete-perm').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-perm-id');
          if (id) deletePermission(id);
        });
      });

    } catch (e) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger font-mono small">Error al consultar permisos.</td></tr>`;
    }
  }

  async function deletePermission(id: string) {
    if (!confirm('¿Confirmas eliminar esta regla de acceso?')) return;
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/permissions/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al eliminar');
      loadPermissions();
    } catch (e: any) {
      alert(e.message);
    }
  }

  function setupForm() {
    const form = document.getElementById('form-permission') as HTMLFormElement;
    const alertEl = document.getElementById('perm-alert') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('token');

      const selectedDays: number[] = [];
      [1,2,3,4,5,6,7].forEach((d) => {
        const dayKey = ['lun','mar','mie','jue','vie','sab','dom'][d-1];
        const chk = document.getElementById(`day-${dayKey}`) as HTMLInputElement;
        if (chk && chk.checked) selectedDays.push(d);
      });

      if (selectedDays.length === 0) {
        alertEl.innerHTML = `<div class="status-pill status-denied w-100 py-2 justify-content-center mb-3">Selecciona al menos un día de la semana</div>`;
        return;
      }

      const hIniVal = (document.getElementById('hora-inicio') as HTMLInputElement).value.trim();
      const hFinVal = (document.getElementById('hora-fin') as HTMLInputElement).value.trim();
      const fLimVal = (document.getElementById('fecha-limite') as HTMLInputElement).value.trim();

      const payload = {
        usuario_id: (document.getElementById('select-persona') as HTMLSelectElement).value,
        dispositivo_id: (document.getElementById('select-puerta') as HTMLSelectElement).value,
        hora_inicio: hIniVal ? (hIniVal.split(':').length === 2 ? `${hIniVal}:00` : hIniVal) : '08:00:00',
        hora_fin: hFinVal ? (hFinVal.split(':').length === 2 ? `${hFinVal}:00` : hFinVal) : '18:00:00',
        dias_semana: selectedDays,
        fecha_limite: fLimVal ? `${fLimVal}T23:59:59Z` : new Date(Date.now() + 365*24*60*60*1000).toISOString()
      };

      try {
        const res = await fetch(`${API_URL}/api/v1/permissions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al guardar regla');

        alertEl.innerHTML = `<div class="status-pill status-granted w-100 py-2 justify-content-center mb-3">Regla sincronizada en tiempo real con la cerradura</div>`;
        loadPermissions();
      } catch (err: any) {
        alertEl.innerHTML = `<div class="status-pill status-denied w-100 py-2 justify-content-center mb-3">${err.message}</div>`;
      }
    });
  }
</script>
