---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Registro de Operador · OpenIoTCore">
  <div class="container d-flex flex-column justify-content-center align-items-center flex-grow-1 py-5" style="max-width: 480px;">
    <div class="card-technical w-100 p-4">
      <div class="text-center mb-4">
        <div class="brand-icon-box mx-auto mb-3" style="width: 40px; height: 40px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
        </div>
        <h5 class="fw-semibold text-light mb-1" style="font-size: 18px; letter-spacing: -0.02em;">Crear cuenta de operador</h5>
        <span class="text-secondary small" style="font-size: 13px;">OpenIoTCore · Gestión y enrolamiento</span>
      </div>

      <div id="alert-container"></div>

      <form id="register-form">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="nombre" class="form-label text-secondary small fw-medium mb-1">Nombre</label>
            <input type="text" class="form-control form-control-dark" id="nombre" placeholder="Ada" required />
          </div>
          <div class="col-md-6">
            <label for="apellido" class="form-label text-secondary small fw-medium mb-1">Apellido</label>
            <input type="text" class="form-control form-control-dark" id="apellido" placeholder="Lovelace" required />
          </div>
        </div>

        <div class="mb-3">
          <label for="correo" class="form-label text-secondary small fw-medium mb-1">Correo institucional</label>
          <input type="email" class="form-control form-control-dark font-mono" id="correo" placeholder="a.lovelace@organizacion.com" required />
        </div>

        <div class="mb-3">
          <label for="departamento" class="form-label text-secondary small fw-medium mb-1">Área / Sede</label>
          <input type="text" class="form-control form-control-dark" id="departamento" placeholder="Infraestructura / SOC" required />
        </div>

        <div class="mb-4">
          <label for="clave" class="form-label text-secondary small fw-medium mb-1">Contraseña (mínimo 6 caracteres)</label>
          <input type="password" class="form-control form-control-dark font-mono" id="clave" placeholder="••••••••••••" minlength="6" required />
        </div>

        <button type="submit" class="btn-primary-dark w-100 py-2 d-flex align-items-center justify-content-center gap-2 mb-3" id="btn-submit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Registrar e ingresar</span>
        </button>
      </form>

      <div class="text-center pt-3" style="border-top: 1px solid var(--border-hairline);">
        <span class="text-muted small">¿Ya tienes credenciales activas?</span>
        <a href="/login" class="text-secondary fw-medium small text-decoration-none ms-1" style="color: var(--accent-cyan) !important;">Iniciar sesión</a>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.openiotcore.org';

  document.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('token')) {
      window.location.href = '/dashboard';
      return;
    }

    const form = document.getElementById('register-form') as HTMLFormElement;
    const alertContainer = document.getElementById('alert-container') as HTMLDivElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertContainer.innerHTML = '';

      const nombre = (document.getElementById('nombre') as HTMLInputElement).value.trim();
      const apellido = (document.getElementById('apellido') as HTMLInputElement).value.trim();
      const correo = (document.getElementById('correo') as HTMLInputElement).value.trim();
      const departamento = (document.getElementById('departamento') as HTMLInputElement).value.trim();
      const clave = (document.getElementById('clave') as HTMLInputElement).value;

      btnSubmit.disabled = true;
      btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-2" style="width: 13px; height: 13px;"></span>Procesando registro...`;

      try {
        const res = await fetch(`${API_URL}/api/v1/auth/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, apellido, correo, departamento, clave, rol: 'USUARIO' })
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Error al procesar el registro');
        }

        localStorage.setItem('token', data.token);
        localStorage.setItem('usuario', JSON.stringify(data.usuario));

        alertContainer.innerHTML = `
          <div class="status-pill status-granted w-100 py-2 justify-content-center mb-3">
            Cuenta registrada con éxito. Redirigiendo...
          </div>
        `;

        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 800);

      } catch (err: any) {
        alertContainer.innerHTML = `
          <div class="status-pill status-denied w-100 py-2 justify-content-center mb-3">
            ${err.message || 'Error al conectar con la API'}
          </div>
        `;
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Registrar e ingresar</span>
        `;
      }
    });
  });
</script>
