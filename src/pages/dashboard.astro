---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Consola de Control · OpenIoTCore">
  <Navbar />

  <main class="container-fluid px-4 py-4 flex-grow-1" style="max-width: 1440px;">
    <div id="dashboard-alert"></div>

    <!-- 1. Tarjetas de Métricas del Día -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="metric-box h-100">
          <div class="metric-label">
            <span>Entradas hoy</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          </div>
          <div class="metric-value text-light" id="stat-entradas">0</div>
          <div class="text-muted small mt-2" style="font-size: 11.5px;">Registros de paso validados</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="metric-box h-100">
          <div class="metric-label">
            <span>Accesos autorizados</span>
            <span class="metric-status-dot dot-online"></span>
          </div>
          <div class="metric-value" style="color: var(--accent-emerald);" id="stat-permitidos">0</div>
          <div class="text-muted small mt-2" style="font-size: 11.5px;">Permitidos por regla u horario</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="metric-box h-100">
          <div class="metric-label">
            <span>Intentos denegados</span>
            <span class="metric-status-dot dot-crimson"></span>
          </div>
          <div class="metric-value" style="color: var(--accent-crimson);" id="stat-denegados">0</div>
          <div class="text-muted small mt-2" style="font-size: 11.5px;">Tarjetas no válidas o fuera de turno</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="metric-box h-100">
          <div class="metric-label">
            <span>Nodos ESP32 activos</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><circle cx="15" cy="15" r="2"/></svg>
          </div>
          <div class="metric-value text-light" id="stat-cerrojos">0 / 0</div>
          <div class="text-muted small mt-2" style="font-size: 11.5px;">Cerraduras conectadas en red</div>
        </div>
      </div>
    </div>

    <!-- 2. Tabla de Actividad Reciente en Puertas -->
    <div class="card-technical mb-4">
      <div class="card-header-technical d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div>
            <h6 class="mb-0 fw-semibold text-light" style="font-size: 14.5px;">Telemetría de accesos recientes</h6>
            <div class="d-flex align-items-center gap-2 mt-1">
              <span class="metric-status-dot dot-online"></span>
              <span class="text-muted small font-mono" style="font-size: 11.5px;">Flujo WebSocket en tiempo real activo</span>
            </div>
          </div>
        </div>
        <div>
          <button class="btn-primary-dark d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalVincularCerradura">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Vincular nodo por código</span>
          </button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table-technical">
          <thead>
            <tr>
              <th class="ps-4">Hora</th>
              <th>Punto de acceso</th>
              <th>Credencial / Titular</th>
              <th>Resultado</th>
              <th class="pe-4">Canal</th>
            </tr>
          </thead>
          <tbody id="activity-table-body">
            <tr>
              <td colspan="5" class="text-center py-4 text-muted font-mono" style="font-size: 13px;">Sincronizando eventos...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. Sección Cerrojos Anclados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h6 class="mb-1 fw-semibold text-light" style="font-size: 14.5px;">Dispositivos y cerraduras registradas</h6>
        <p class="text-muted small mb-0" style="font-size: 12.5px;">Monitoreo de estado de enlace, latencia y activación de relé remoto.</p>
      </div>
    </div>
    <div class="row g-3" id="locks-container">
      <div class="col-12 text-center py-4 text-muted font-mono" style="font-size: 13px;">Cargando dispositivos...</div>
    </div>
  </main>

  <!-- Modal Vincular Cerrojo por Código (OLED Display Simulation) -->
  <div class="modal fade" id="modalVincularCerradura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <div class="brand-icon-box" style="width: 24px; height: 24px;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-1.5 1.5L12 11l4 4 5.5-5.5a2.12 2.12 0 0 0 0-3L21 2z"/><path d="M15.5 7.5L19 11"/></svg>
            </div>
            <h6 class="modal-title fw-semibold text-light mb-0" style="font-size: 14.5px;">Vincular nodo ESP32</h6>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body p-4">
          <div id="modal-alert"></div>

          <!-- Preview de Pantalla OLED Física -->
          <div class="text-center mb-4">
            <div class="text-muted small mb-2" style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em;">Código en display OLED (0.96")</div>
            <div class="oled-container w-100">
              <span id="oled-preview-text" style="font-size: 20px; font-weight: 600;">----  ----</span>
            </div>
            <div class="text-muted small mt-2" style="font-size: 11.5px;">El nodo genera un código temporal de 8 caracteres al iniciar o pulsar reset.</div>
          </div>

          <form id="form-claim-code">
            <div class="mb-3">
              <label class="form-label text-secondary small fw-medium mb-1">Código de emparejamiento</label>
              <input 
                type="text" 
                class="form-control form-control-dark font-mono text-center text-uppercase" 
                id="pairing-code-input" 
                placeholder="EJ: AEIO-4283" 
                maxlength="9" 
                required 
                style="font-size: 17px; letter-spacing: 0.15em;"
              />
              <div class="text-muted small mt-1" style="font-size: 11.5px;">Vigencia: 1 hora desde la emisión en hardware.</div>
            </div>
            <button type="submit" class="btn-primary-dark w-100 py-2 d-flex align-items-center justify-content-center gap-2" id="btn-claim-submit">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span>Vincular dispositivo a la consola</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.openiotcore.org';

  document.addEventListener('DOMContentLoaded', () => {
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/login';
      return;
    }

    loadSummary();
    loadLocks();
    initWebSocket();
    setupClaimForm();

    // Sincronizar input con preview OLED
    const codeInput = document.getElementById('pairing-code-input') as HTMLInputElement;
    const oledPreview = document.getElementById('oled-preview-text');
    codeInput?.addEventListener('input', () => {
      const val = codeInput.value.trim().toUpperCase();
      if (oledPreview) {
        oledPreview.textContent = val.length > 0 ? val : '----  ----';
      }
    });
  });

  async function loadSummary() {
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/dashboard/summary`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) return;
      const data = await res.json();

      document.getElementById('stat-entradas')!.textContent = data.entradas_hoy || '0';
      document.getElementById('stat-permitidos')!.textContent = data.permitidos_hoy || '0';
      document.getElementById('stat-denegados')!.textContent = data.denegados_hoy || '0';
      document.getElementById('stat-cerrojos')!.textContent = `${data.dispositivos?.online || 0} / ${data.dispositivos?.total || 0}`;

      renderActivityTable(data.actividad_reciente || []);
    } catch (e) {}
  }

  function renderActivityTable(activityList: any[]) {
    const tbody = document.getElementById('activity-table-body');
    if (!tbody) return;

    if (activityList.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted font-mono" style="font-size: 12.5px;">No hay eventos registrados en la jornada.</td></tr>`;
      return;
    }

    tbody.innerHTML = activityList.map((item: any) => {
      const hora = item.timestamp ? new Date(item.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '--:--:--';
      const puerta = item.ubicacion || 'Puerta Principal';
      const persona = item.nombre 
        ? `<span class="text-light fw-medium">${item.nombre} ${item.apellido || ''}</span>` 
        : `<span class="uid-badge"><span class="text-muted">UID:</span> ${item.uid_leido}</span>`;
      
      const isPermitido = item.evento === 'PERMITIDO' || item.evento === 'OFFLINE_PERMITIDO';
      const resultadoHtml = isPermitido
        ? `<span class="status-pill status-granted"><span class="metric-status-dot dot-online"></span>Concedido</span>`
        : `<span class="status-pill status-denied"><span class="metric-status-dot dot-crimson"></span>Denegado</span>`;

      const isOffline = item.evento && item.evento.includes('OFFLINE');
      const modoHtml = isOffline 
        ? `<span class="status-pill status-neutral font-mono text-warning" style="font-size: 11px;">Caché NVS local</span>` 
        : `<span class="status-pill status-neutral font-mono text-secondary" style="font-size: 11px;">Enlace en línea</span>`;

      return `
        <tr>
          <td class="ps-4 font-mono text-muted" style="font-size: 12.5px;">${hora}</td>
          <td><span class="text-light fw-medium">${puerta}</span></td>
          <td>${persona}</td>
          <td>${resultadoHtml}</td>
          <td class="pe-4">${modoHtml}</td>
        </tr>
      `;
    }).join('');
  }

  async function loadLocks() {
    const container = document.getElementById('locks-container');
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/devices/my-devices`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al consultar cerrojos');

      const locks = await res.json();
      if (!container) return;

      if (locks.length === 0) {
        container.innerHTML = `
          <div class="col-12">
            <div class="card-technical text-center py-5">
              <div class="brand-icon-box mx-auto mb-3" style="width: 44px; height: 44px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect width="18" height="18" x="3" y="3" rx="2"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              </div>
              <h6 class="fw-semibold text-light mb-1">No hay nodos vinculados</h6>
              <p class="text-secondary small mb-3">Introduce el código alfanumérico emitido en la pantalla OLED de la cerradura.</p>
              <button class="btn-primary-dark d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalVincularCerradura">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>Vincular primer dispositivo</span>
              </button>
            </div>
          </div>
        `;
        return;
      }

      container.innerHTML = locks.map((lock: any) => {
        const isOnline = lock.estado_efectivo === 'ONLINE';
        const latencyText = lock.websocket_active ? '12 ms' : 'En línea';
        const tagStatus = isOnline
          ? `<span class="status-pill status-granted"><span class="metric-status-dot dot-online"></span>${latencyText}</span>`
          : `<span class="status-pill status-neutral text-warning"><span class="metric-status-dot dot-amber"></span>Caché NVS (Offline)</span>`;

        return `
          <div class="col-md-6 col-xl-4">
            <div class="card-technical p-4 h-100 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="fw-semibold text-light mb-0" style="font-size: 15px;">${lock.ubicacion || 'Punto de Acceso'}</h6>
                  ${tagStatus}
                </div>
                <div class="text-secondary small mb-3" style="font-size: 12.5px;">${lock.zona_piso || 'Acceso Principal'}</div>
                
                <div class="d-flex align-items-center gap-2 mb-3">
                  <span class="text-muted small font-mono" style="font-size: 11.5px;">IP:</span>
                  <span class="uid-badge font-mono" style="font-size: 11.5px;">${lock.direccion_ip || '192.168.1.xxx'}</span>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid var(--border-hairline);">
                <span class="text-muted font-mono" style="font-size: 11px;">ID: ${lock.id ? lock.id.substring(0, 8) : 'ESP32'}</span>
                <button class="btn-unlock-action btn-unlock" data-device-id="${lock.id}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
                  <span>Abrir relé</span>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.btn-unlock').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const devId = target.getAttribute('data-device-id');
          if (devId) unlockLock(devId, target);
        });
      });

    } catch (e) {
      if (container) container.innerHTML = `<div class="col-12 text-center text-danger py-4 font-mono small">Error al sincronizar lista de cerrojos.</div>`;
    }
  }

  async function unlockLock(deviceId: string, btn: HTMLButtonElement) {
    const token = localStorage.getItem('token');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" style="width: 12px; height: 12px;"></span>...`;

    try {
      const res = await fetch(`${API_URL}/api/v1/devices/${deviceId}/unlock`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Dispositivo no respondió a la orden de apertura');

      btn.classList.add('active-unlocked');
      btn.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Abierto</span>
      `;
      setTimeout(() => {
        btn.classList.remove('active-unlocked');
        btn.innerHTML = origHtml;
        btn.disabled = false;
      }, 3500);
    } catch (e: any) {
      alert(e.message || 'Error de comunicación');
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  function setupClaimForm() {
    const form = document.getElementById('form-claim-code') as HTMLFormElement;
    const alertEl = document.getElementById('modal-alert') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertEl.innerHTML = '';
      const code = (document.getElementById('pairing-code-input') as HTMLInputElement).value.trim();
      const token = localStorage.getItem('token');

      try {
        const res = await fetch(`${API_URL}/api/v1/devices/claim-by-code`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ pairing_code: code })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Código inválido o expirado');

        alertEl.innerHTML = `<div class="status-pill status-granted w-100 py-2 justify-content-center mb-3">Dispositivo vinculado correctamente</div>`;
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        alertEl.innerHTML = `<div class="status-pill status-denied w-100 py-2 justify-content-center mb-3">${err.message}</div>`;
      }
    });
  }

  function initWebSocket() {
    const token = localStorage.getItem('token');
    if (!token) return;

    const wsProto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = API_URL.replace('http://', '').replace('https://', '');
    const ws = new WebSocket(`${wsProto}//${host}/ws?type=web&token=${token}`);

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.event === 'access_event') {
          loadSummary();
        } else if (msg.event === 'device_status') {
          loadLocks();
        }
      } catch (e) {}
    };
  }
</script>
