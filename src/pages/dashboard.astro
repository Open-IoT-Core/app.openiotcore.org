---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Dashboard - OpenIoTCore">
  <Navbar />

  <main class="container-fluid px-4 py-4 flex-grow-1">
    <div id="dashboard-alert"></div>

    <!-- 1. Tarjetas de Métricas del Día -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-3">
            <span class="text-muted small fw-semibold">Entradas registradas hoy</span>
            <h2 class="fw-bold text-dark mt-2 mb-0" id="stat-entradas">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-3">
            <span class="text-muted small fw-semibold">Accesos válidos</span>
            <h2 class="fw-bold text-success mt-2 mb-0" id="stat-permitidos">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-3">
            <span class="text-muted small fw-semibold">Intentos rechazados</span>
            <h2 class="fw-bold text-danger mt-2 mb-0" id="stat-denegados">0</h2>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-3">
            <span class="text-muted small fw-semibold">Cerrojos sincronizados</span>
            <h2 class="fw-bold text-dark mt-2 mb-0" id="stat-cerrojos">0 / 0</h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Tabla de Actividad Reciente en Puertas -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="fw-bold mb-0 text-dark">Actividad reciente en puertas</h5>
          <small class="text-muted"><i class="bi bi-circle-fill text-success small me-1"></i> Conexión en vivo activa</small>
        </div>
        <button class="btn btn-primary btn-sm fw-bold px-3" data-bs-toggle="modal" data-bs-target="#modalVincularCerradura">
          <i class="bi bi-plus-circle me-1"></i> Vincular cerrojo por código
        </button>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small">
              <tr>
                <th class="ps-4">Hora</th>
                <th>Puerta / Cerrojo</th>
                <th>Persona o Credencial</th>
                <th>Resultado</th>
                <th>Modo</th>
              </tr>
            </thead>
            <tbody id="activity-table-body">
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">Cargando actividad...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- 3. Sección Cerrojos Anclados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold text-dark mb-0">Cerrojos anclados</h4>
    </div>
    <div class="row g-3" id="locks-container">
      <div class="col-12 text-center py-4 text-muted">Cargando cerrojos...</div>
    </div>
  </main>

  <!-- Modal Vincular Cerrojo por Código -->
  <div class="modal fade" id="modalVincularCerradura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title fw-bold text-warning"><i class="bi bi-key-fill me-2"></i>Vincular Cerrojo Inteligente</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div id="modal-alert"></div>
          <form id="form-claim-code">
            <div class="mb-3">
              <label class="form-label fw-bold">Código de 8 dígitos de la pantalla OLED</label>
              <input type="text" class="form-control form-control-lg text-center fw-bold text-uppercase" id="pairing-code-input" placeholder="EJ: AEIO-4283" maxlength="9" required />
              <div class="form-text">Introduce el código mostrado en la cerradura. Vigencia: 1 hora.</div>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold py-2" id="btn-claim-submit">
              <i class="bi bi-link-45deg me-1"></i> Vincular cerrojo a mi cuenta
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'https://api.openiotcore.org';

  document.addEventListener('DOMContentLoaded', () => {
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/login';
      return;
    }

    loadSummary();
    loadLocks();
    initWebSocket();
    setupClaimForm();
  });

  async function loadSummary() {
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/dashboard/summary`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) return;
      const data = await res.json();

      document.getElementById('stat-entradas')!.textContent = data.entradas_hoy || '0';
      document.getElementById('stat-permitidos')!.textContent = data.permitidos_hoy || '0';
      document.getElementById('stat-denegados')!.textContent = data.denegados_hoy || '0';
      document.getElementById('stat-cerrojos')!.textContent = `${data.dispositivos?.online || 0} / ${data.dispositivos?.total || 0}`;

      renderActivityTable(data.actividad_reciente || []);
    } catch (e) {}
  }

  function renderActivityTable(activityList: any[]) {
    const tbody = document.getElementById('activity-table-body');
    if (!tbody) return;

    if (activityList.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-muted">No hay accesos registrados hoy.</td></tr>`;
      return;
    }

    tbody.innerHTML = activityList.map((item: any) => {
      const hora = item.timestamp ? new Date(item.timestamp).toLocaleTimeString() : '--:--:--';
      const puerta = item.ubicacion || 'Puerta Principal';
      const persona = item.nombre ? `${item.nombre} ${item.apellido}` : `<span class="badge bg-warning text-dark font-monospace">Tarjeta no registrada (UID: ${item.uid_leido})</span>`;
      
      const isPermitido = item.evento === 'PERMITIDO' || item.evento === 'OFFLINE_PERMITIDO';
      const resultadoHtml = isPermitido
        ? `<span class="text-success fw-bold">Acceso concedido</span>`
        : `<span class="text-danger text-decoration-line-through fw-bold">Acceso denegado</span>`;

      const isOffline = item.evento.includes('OFFLINE');
      const modoHtml = isOffline ? 'Memoria local (Sin red)' : 'En línea';

      return `
        <tr>
          <td class="ps-4 text-muted small">${hora}</td>
          <td class="fw-bold">${puerta}</td>
          <td>${persona}</td>
          <td>${resultadoHtml}</td>
          <td class="small text-muted">${modoHtml}</td>
        </tr>
      `;
    }).join('');
  }

  async function loadLocks() {
    const container = document.getElementById('locks-container');
    const token = localStorage.getItem('token');
    try {
      const res = await fetch(`${API_URL}/api/v1/devices/my-devices`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al cargar cerrojos');

      const locks = await res.json();
      if (!container) return;

      if (locks.length === 0) {
        container.innerHTML = `
          <div class="col-12">
            <div class="card text-center py-5 border-dashed">
              <div class="card-body">
                <i class="bi bi-key text-muted display-5 mb-2 d-block"></i>
                <h5 class="fw-bold">No hay cerrojos anclados</h5>
                <p class="text-muted">Ingresa el código de 8 dígitos de tu pantalla OLED para vincular un cerrojo.</p>
                <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalVincularCerradura">
                  + Vincular cerrojo
                </button>
              </div>
            </div>
          </div>
        `;
        return;
      }

      container.innerHTML = locks.map((lock: any) => {
        const isOnline = lock.estado_efectivo === 'ONLINE';
        const tagStatus = isOnline
          ? `<span class="text-success small fw-bold"><i class="bi bi-circle-fill small me-1"></i>Operativa (${lock.websocket_active ? '12 ms' : 'En línea'})</span>`
          : `<span class="badge bg-warning text-dark fw-normal"><i class="bi bi-exclamation-circle-fill me-1"></i>Funcionando en local (Caché NVS)</span>`;

        return `
          <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3">${lock.ubicacion}</h5>
                <p class="text-muted small mb-1"><strong>Ubicación:</strong> ${lock.zona_piso || 'Entrada central'}</p>
                <p class="text-muted small mb-3"><strong>IP asignada:</strong> <code class="bg-light text-muted px-2 py-1 rounded">${lock.direccion_ip}</code></p>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                  ${tagStatus}
                  <button class="btn btn-outline-primary btn-sm fw-bold px-3 btn-unlock" data-device-id="${lock.id}">
                    <i class="bi bi-unlock-fill me-1"></i> Desbloquear
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.btn-unlock').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const devId = target.getAttribute('data-device-id');
          if (devId) unlockLock(devId, target);
        });
      });

    } catch (e) {
      if (container) container.innerHTML = `<div class="col-12 text-center text-danger py-4">Error cargando cerrojos.</div>`;
    }
  }

  async function unlockLock(deviceId: string, btn: HTMLButtonElement) {
    const token = localStorage.getItem('token');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>...';

    try {
      const res = await fetch(`${API_URL}/api/v1/devices/${deviceId}/unlock`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al desbloquear');

      btn.className = 'btn btn-success btn-sm fw-bold px-3';
      btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Abierta';
      setTimeout(() => {
        btn.className = 'btn btn-outline-primary btn-sm fw-bold px-3';
        btn.innerHTML = origHtml;
        btn.disabled = false;
      }, 4000);
    } catch (e: any) {
      alert(e.message);
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  function setupClaimForm() {
    const form = document.getElementById('form-claim-code') as HTMLFormElement;
    const alertEl = document.getElementById('modal-alert') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertEl.innerHTML = '';
      const code = (document.getElementById('pairing-code-input') as HTMLInputElement).value.trim();
      const token = localStorage.getItem('token');

      try {
        const res = await fetch(`${API_URL}/api/v1/devices/claim-by-code`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify({ pairing_code: code })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Código inválido');

        alertEl.innerHTML = `<div class="alert alert-success">¡Cerrojo vinculado con éxito!</div>`;
        setTimeout(() => window.location.reload(), 1200);
      } catch (err: any) {
        alertEl.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
      }
    });
  }

  function initWebSocket() {
    const token = localStorage.getItem('token');
    if (!token) return;

    const wsProto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const host = API_URL.replace('http://', '').replace('https://', '');
    const ws = new WebSocket(`${wsProto}//${host}/ws?type=web&token=${token}`);

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.event === 'access_event') {
          loadSummary();
        } else if (msg.event === 'device_status') {
          loadLocks();
        }
      } catch (e) {}
    };
  }
</script>
