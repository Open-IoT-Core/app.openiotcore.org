---
---

<nav class="navbar navbar-expand-lg navbar-custom">
  <div class="container-fluid px-0">
    <a class="brand-badge" href="/dashboard">
      <div class="brand-icon-box">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M7 7h.01"/>
          <path d="M17 7h.01"/>
          <path d="M7 17h.01"/>
          <path d="M17 17h.01"/>
        </svg>
      </div>
      <span>OpenIoTCore</span>
    </a>

    <button class="navbar-toggler border-0 shadow-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-label="Navegación">
      <i class="bi bi-list fs-4"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
        <li class="nav-item">
          <a class="nav-link-custom" id="nav-dashboard" href="/dashboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="9" x="3" y="3" rx="1"/>
              <rect width="7" height="5" x="14" y="3" rx="1"/>
              <rect width="7" height="9" x="14" y="12" rx="1"/>
              <rect width="7" height="5" x="3" y="16" rx="1"/>
            </svg>
            <span>Consola</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link-custom" id="nav-users" href="/users">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Personal y tarjetas</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link-custom" id="nav-permissions" href="/permissions">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Reglas y horarios</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link-custom" id="nav-audit" href="/audit">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span>Auditoría forense</span>
          </a>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
        <div class="d-flex align-items-center gap-2 px-2 py-1 rounded" style="background: var(--bg-surface); border: 1px solid var(--border-hairline);">
          <span class="metric-status-dot dot-online"></span>
          <span class="text-secondary small font-mono" id="nav-user-name" style="font-size: 12.5px;">Operador activo</span>
        </div>
        <button class="btn-secondary-dark d-flex align-items-center gap-2" id="btn-logout" title="Cerrar sesión">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          <span style="font-size: 12.5px;">Desconectar</span>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const path = window.location.pathname;
    if (path.includes('/dashboard')) document.getElementById('nav-dashboard')?.classList.add('active');
    if (path.includes('/users')) document.getElementById('nav-users')?.classList.add('active');
    if (path.includes('/permissions')) document.getElementById('nav-permissions')?.classList.add('active');
    if (path.includes('/audit')) document.getElementById('nav-audit')?.classList.add('active');

    const token = localStorage.getItem('token');
    const usuarioRaw = localStorage.getItem('usuario');

    if (!token && !['/', '/login', '/register'].includes(path)) {
      window.location.href = '/login';
      return;
    }

    if (usuarioRaw) {
      try {
        const usr = JSON.parse(usuarioRaw);
        const nameEl = document.getElementById('nav-user-name');
        if (nameEl) nameEl.textContent = `${usr.nombre} ${usr.apellido} (${usr.rol || 'OPERADOR'})`;
      } catch (e) {}
    }

    document.getElementById('btn-logout')?.addEventListener('click', () => {
      localStorage.removeItem('token');
      localStorage.removeItem('usuario');
      window.location.href = '/login';
    });
  });
</script>
